rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. User Profiles, Schedules & HSS Audits (Personal User Data)
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || true);
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
    
    // 2. Real-Time Crew Chat Channels & Live Messages
    match /chat_channels/{channelId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 3. Fallback for authenticated crew members in app
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
